# ─── Application Configuration ──────────────────────────────────────
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO
SECRET_KEY=change_me_in_production

# ─── LLM Configuration (Anthropic Claude or OpenAI) ─────────────────
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# If your Anthropic API key is an organization/identity-linked key, specify your workspace ID:
ANTHROPIC_WORKSPACE_ID=  # e.g. wrkspc_01... (leave blank if standard personal key)
OPENAI_API_KEY=your_openai_api_key_here
# For Anthropic (Claude 3.5 Haiku / Claude 3.7):
PRIMARY_MACRO_MODEL=claude-3-5-haiku-20241022
FAST_SENTIMENT_MODEL=claude-3-5-haiku-20241022
# For OpenAI:
# PRIMARY_MACRO_MODEL=gpt-4o
# FAST_SENTIMENT_MODEL=gpt-4o-mini

# ─── LLM Observability & Cost Tracking (Helicone / LangSmith) ──────────
# Set your Helicone API key (https://helicone.ai) to view all requests/responses, latency, and costs:
HELICONE_API_KEY=
# Or set LangSmith API key (https://smith.langchain.com) for tracing:
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=quantedge
# 24-Hour Model Output Cache (Hours before querying LLM again):
MACRO_CACHE_TTL_HOURS=24.0

# ─── Database & Cache ────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=quantedge
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
REDIS_URL=redis://localhost:6379/0

# ─── Exness MT4 / MT5 ZeroMQ Bridge ─────────────────────────────────
ZMQ_HOST=127.0.0.1
ZMQ_REQ_PORT=5555
ZMQ_SUB_PORT=5556
EXNESS_ACCOUNT_TYPE=Demo

# ─── Data Provider Keys ──────────────────────────────────────────────
MASSIVE_API_KEY=your_massive_api_key_here # (formerly Polygon.io - api.massive.com)
POLYGON_API_KEY= # optional backwards-compatibility alias
NEWSAPI_KEY=your_newsapi_key

# ─── Risk Controls ────────────────────────────────────────────────────
RISK_PER_TRADE_PCT=1.0
MAX_PORTFOLIO_HEAT_PCT=5.0
MAX_DAILY_DRAWDOWN_PCT=3.0
ENABLE_LIVE_TRADING=false

# Bridge: file = Exness MT4 (default); tcp = MT5 socket EA
BRIDGE_TRANSPORT=file
BRIDGE_FILE_DIR=

# ─── High-Intensity Day Trading & Reinforcement Learning ───────────────
SIGNAL_INTERVAL_SEC=5.0
INTRADAY_MAX_TRADES_PER_DAY=20
RL_ENABLED=true
RL_LEARNING_RATE=0.1
RL_EXPLORATION_RATE=0.1
RL_MEMORY_FILE=data/rl_trade_memory.json

